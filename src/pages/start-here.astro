---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = await getEntry('pages', 'start-here');
const { Content } = page ? await render(page) : { Content: null };
---
<Base title={page?.data.title ?? 'Start here'} description={page?.data.description}>
  <h1>{page?.data.title ?? 'Start here'}</h1>
  {page ? <Content /> : <p>Run <code>npm run sync</code> to pull this page's content from the vault.</p>}
</Base>
